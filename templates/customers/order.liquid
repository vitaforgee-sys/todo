<section class="vf-section">
  <div class="vf-wrap">
    <header class="vf-head">
      <h1>Pedido {{ order.name }}</h1>
      <hr class="vf-rule">
      <p class="vf-quote__meta">Realizado el {{ order.created_at | date: '%d de %B de %Y' }}</p>
    </header>

    <div class="vf-table-wrap">
      <table class="vf-table">
        <thead>
          <tr>
            <th scope="col">Producto</th>
            <th scope="col">Cantidad</th>
            <th scope="col">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <th scope="row">{{ line_item.title }}</th>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="vf-cart-summary">
      <div class="vf-cart-summary__row"><span>Subtotal</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
      <div class="vf-cart-summary__row"><span>Envio</span><span>{{ order.shipping_price | money }}</span></div>
      <div class="vf-cart-summary__row vf-cart-summary__row--total"><span>Total</span><span>{{ order.total_price | money }}</span></div>
    </div>
  </div>
</section>
