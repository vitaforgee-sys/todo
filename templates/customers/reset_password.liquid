<section class="vf-section">
  <div class="vf-wrap vf-wrap--narrow">
    <header class="vf-head vf-head--center">
      <h1>Cambiar la contraseña</h1>
      <hr class="vf-rule" style="margin-inline: auto;">
    </header>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="vf-alert vf-alert--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="vf-field">
        <label for="vf-reset-pass">Contraseña nueva</label>
        <input type="password" id="vf-reset-pass" name="customer[password]" class="vf-input" autocomplete="new-password" required>
      </div>
      <div class="vf-field">
        <label for="vf-reset-pass2">Repite la contraseña</label>
        <input type="password" id="vf-reset-pass2" name="customer[password_confirmation]" class="vf-input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="vf-btn vf-btn--primary vf-btn--full">Guardar</button>
    {%- endform -%}
  </div>
</section>
