<div class="vf-wrap vf-wrap--narrow vf-text-center">
  <span class="vf-eyebrow">Muy pronto</span>
  <h1>{{ shop.name }}</h1>
  <hr class="vf-rule" style="margin-inline: auto;">
  <p class="vf-lede" style="margin-inline: auto;">
    Estamos dando los ultimos retoques. Dejanos tu correo y te avisamos el dia que abramos.
  </p>

  {%- form 'customer', class: 'vf-newsletter', style: 'margin-top: 2rem;' -%}
    <input type="hidden" name="contact[tags]" value="prelanzamiento">
    {%- if form.posted_successfully? -%}
      <p class="vf-alert vf-alert--ok">Gracias. Te escribiremos en cuanto abramos.</p>
    {%- endif -%}
    <div class="vf-newsletter__row">
      <div class="vf-field" style="margin-bottom: 0;">
        <label for="vf-pw-email" class="vf-visually-hidden">Correo electronico</label>
        <input type="email" id="vf-pw-email" name="contact[email]" class="vf-input" placeholder="tunombre@correo.com" required>
      </div>
      <button type="submit" class="vf-btn vf-btn--primary">Avisadme</button>
    </div>
  {%- endform -%}

  <p style="margin-top: 2.5rem;">
    {%- form 'storefront_password' -%}
      <label for="vf-pw" class="vf-visually-hidden">Contraseña de la tienda</label>
      <input type="password" id="vf-pw" name="password" class="vf-input" placeholder="Contraseña de acceso" style="max-width: 22rem; margin-inline: auto;">
      <button type="submit" class="vf-btn vf-btn--outline" style="margin-top: 0.75rem;">Entrar</button>
    {%- endform -%}
  </p>
</div>
