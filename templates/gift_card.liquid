<section class="vf-section">
  <div class="vf-wrap vf-wrap--narrow vf-text-center">
    <span class="vf-eyebrow">{{ shop.name }}</span>
    <h1>Tu tarjeta regalo</h1>
    <hr class="vf-rule" style="margin-inline: auto;">
    <p class="vf-lede" style="margin-inline: auto;">Por valor de {{ gift_card.initial_value | money }}</p>

    <div class="vf-card" style="margin-top: 2rem;">
      {{ gift_card.qr_identifier }}
      <p style="font-size: var(--vf-fs-xl); letter-spacing: 0.12em; margin-top: 1rem;">
        {{ gift_card.code | format_code }}
      </p>
      {%- if gift_card.expires_on -%}
        <p class="vf-quote__meta">Valida hasta el {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
      {%- endif -%}
    </div>

    <div class="vf-btn-row" style="justify-content: center;">
      <a href="{{ shop.url }}" class="vf-btn vf-btn--primary">Ir a la tienda</a>
    </div>
  </div>
</section>
