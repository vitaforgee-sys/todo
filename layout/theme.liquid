<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_deep }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%} Tipografias servidas por Shopify: sin peticiones externas. {%- endcomment -%}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

    <style>
      :root {
        --vf-font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --vf-font-head-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --vf-cream: {{ settings.color_background }};
        --vf-sand: {{ settings.color_sand }};
        --vf-sand-soft: {{ settings.color_sand | color_mix: '#ffffff', 45 }};
        --vf-ink: {{ settings.color_text }};
        --vf-ink-soft: {{ settings.color_text | color_mix: settings.color_background, 62 }};
        --vf-line: {{ settings.color_sand | color_darken: 6 }};
        --vf-accent: {{ settings.color_accent }};
        --vf-accent-soft: {{ settings.color_accent | color_lighten: 8 }};
        --vf-deep: {{ settings.color_deep }};
        --vf-gold: {{ settings.color_gold }};
        --vf-fs-base: {{ settings.base_font_size }}px;
      }
    </style>

    <link rel="stylesheet" href="{{ 'vitaforge.css' | asset_url }}">
    <script src="{{ 'vitaforge.js' | asset_url }}" defer="defer"></script>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="vf-skip-link" href="#vf-main">Saltar al contenido principal</a>

    {% sections 'header-group' %}

    <main id="vf-main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
