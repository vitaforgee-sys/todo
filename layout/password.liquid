<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}

      :root {
        --vf-font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --vf-font-head-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --vf-cream: {{ settings.color_background }};
        --vf-ink: {{ settings.color_text }};
        --vf-accent: {{ settings.color_accent }};
      }
    </style>
    <link rel="stylesheet" href="{{ 'vitaforge.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    <main class="vf-section">
      {{ content_for_layout }}
    </main>
  </body>
</html>
