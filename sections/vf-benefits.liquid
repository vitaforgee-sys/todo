<section class="vf-section">
  <div class="vf-wrap">
    {%- render 'vf-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'center'
    -%}

    <div class="vf-grid vf-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="vf-card vf-reveal" {{ block.shopify_attributes }}>
          <div class="vf-card__icon">
            {%- render 'vf-icon', icon: block.settings.icon, size: 44 -%}
          </div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo", "default": "Por que funciona" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Cuatro frentes, una sola capsula" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Entradilla",
      "default": "<p>En lugar de tomar cuatro botes distintos, VitaForge cubre en una sola formula lo que el cuerpo deja de producir a partir de los 45.</p>"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "spark", "label": "Energia" },
            { "value": "moon", "label": "Descanso" },
            { "value": "bone", "label": "Huesos" },
            { "value": "leaf", "label": "Piel y cabello" },
            { "value": "heart", "label": "Corazon" },
            { "value": "shield", "label": "Defensas" },
            { "value": "capsule", "label": "Capsula" },
            { "value": "flask", "label": "Laboratorio" }
          ],
          "default": "spark"
        },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Energia que dura hasta la tarde" },
        { "type": "richtext", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Beneficios",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "spark", "title": "Energia que llega a la tarde", "text": "<p>Magnesio, hierro y vitaminas del grupo B contribuyen a disminuir el cansancio y la fatiga.</p>" } },
        { "type": "benefit", "settings": { "icon": "bone", "title": "Huesos y articulaciones", "text": "<p>Vitamina D3, K2 y colageno para el mantenimiento de los huesos en condiciones normales.</p>" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Piel, pelo y uñas", "text": "<p>Vitamina C, zinc y colageno: la vitamina C contribuye a la formacion normal de colageno para la piel.</p>" } },
        { "type": "benefit", "settings": { "icon": "moon", "title": "Equilibrio del dia a dia", "text": "<p>La vitamina B6 contribuye a regular la actividad hormonal y el magnesio al sistema nervioso normal.</p>" } }
      ]
    }
  ]
}
{% endschema %}
