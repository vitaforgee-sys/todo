<section class="vf-section vf-section--sand">
  <div class="vf-wrap">
    {%- render 'vf-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'center'
    -%}

    <div class="vf-steps">
      {%- for block in section.blocks -%}
        <div class="vf-step vf-reveal" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="vf-table-note vf-text-center" style="margin-inline: auto; margin-top: 2rem;">
        {{ section.settings.note }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Como se toma",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo", "default": "Modo de empleo" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Tan sencillo que no lo olvidaras" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Entradilla",
      "default": "<p>Sin horarios imposibles ni cinco botes en la encimera.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Nota al pie",
      "default": "<p>No superar la dosis diaria recomendada. Los complementos alimenticios no deben utilizarse como sustitutos de una dieta equilibrada.</p>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Titulo", "default": "Con el desayuno" },
        { "type": "richtext", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Como se toma",
      "blocks": [
        { "type": "step", "settings": { "title": "Dos capsulas con el desayuno", "text": "<p>Con un vaso de agua y algo de comida. La grasa del desayuno ayuda a absorber la vitamina D3 y la K2.</p>" } },
        { "type": "step", "settings": { "title": "Todos los dias, sin saltarte ninguno", "text": "<p>La constancia importa mas que la dosis. Deja el bote a la vista, junto a la cafetera.</p>" } },
        { "type": "step", "settings": { "title": "Dale entre 8 y 12 semanas", "text": "<p>El cuerpo necesita tiempo para reponer reservas. Por eso la garantia es de 60 dias y no de siete.</p>" } }
      ]
    }
  ]
}
{% endschema %}
