<section class="vf-section{% if section.settings.background == 'sand' %} vf-section--sand{% elsif section.settings.background == 'surface' %} vf-section--surface{% endif %}">
  <div class="vf-wrap">
    <div class="vf-split{% if section.settings.flip %} vf-split--flip{% endif %}">
      <div class="vf-split__media vf-reveal">
        {%- render 'vf-media',
          image: section.settings.image,
          ratio: section.settings.ratio,
          alt: section.settings.image_alt,
          fallback: section.settings.fallback,
          sizes: '(min-width: 990px) 48vw, 100vw'
        -%}
      </div>

      <div class="vf-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vf-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
          <hr class="vf-rule">
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="vf-rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="vf-hero__points">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'vf-icon', icon: 'check-circle', size: 22 -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <div class="vf-btn-row">
            <a href="{{ section.settings.cta_link }}" class="vf-btn vf-btn--primary">
              {{ section.settings.cta_text | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texto con imagen",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo" },
    {
      "type": "select",
      "id": "fallback",
      "label": "Ilustracion mientras no subas foto",
      "options": [
        { "value": "vf-art-duo.svg", "label": "Dos mujeres" },
        { "value": "vf-art-portrait.svg", "label": "Retrato" },
        { "value": "vf-art-still-life.svg", "label": "Bodegon del producto" },
        { "value": "", "label": "Ninguna" }
      ],
      "default": "vf-art-duo.svg"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Formato de la imagen",
      "options": [
        { "value": "portrait", "label": "Vertical" },
        { "value": "square", "label": "Cuadrada" },
        { "value": "wide", "label": "Apaisada" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "flip", "label": "Imagen a la derecha", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Antetitulo" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Pensado para una mujer concreta, no para todo el mundo" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "cta_text", "label": "Boton" },
    { "type": "url", "id": "cta_link", "label": "Enlace del boton" },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "sand", "label": "Arena" },
        { "value": "surface", "label": "Blanco" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Punto",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texto" }]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Texto con imagen",
      "settings": {
        "eyebrow": "Nuestra historia",
        "heading": "Pensado para una mujer concreta, no para todo el mundo",
        "text": "<p>VitaForge no nacio en una sala de reuniones. Nacio de escuchar a mujeres de 50 a 60 años decir siempre lo mismo: que se sentian invisibles en la consulta, que les recetaban paciencia y que ninguna formula del mercado estaba pensada de verdad para ellas.</p><p>Asi que hicimos lo contrario: elegimos primero a quien queriamos ayudar y despues construimos la formula. Cada ingrediente esta ahi por una razon concreta, en la dosis que la evidencia respalda.</p>"
      },
      "blocks": [
        { "type": "point", "settings": { "text": "<p>Formulado y fabricado en España bajo norma GMP.</p>" } },
        { "type": "point", "settings": { "text": "<p>Certificado de analisis disponible para cada lote.</p>" } },
        { "type": "point", "settings": { "text": "<p>Sin suscripciones trampa: compras cuando quieres.</p>" } }
      ]
    }
  ]
}
{% endschema %}
