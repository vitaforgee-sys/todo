<section class="vf-section vf-section--deep">
  <div class="vf-wrap">
    <div class="vf-guarantee vf-reveal">
      <div class="vf-guarantee__seal">
        {%- render 'vf-icon', icon: 'seal', size: 96 -%}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="vf-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vf-lede">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <div class="vf-btn-row" style="justify-content: center;">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="vf-btn vf-btn--primary">
            {{ section.settings.cta_text | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garantia",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo", "default": "Sin riesgo para ti" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "60 dias para probarlo. O te devolvemos el dinero." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Pruebalo dos meses enteros. Si al terminar el bote no notas la diferencia, escribenos un correo y te devolvemos el importe integro. Sin formularios, sin devolver el envase y sin tener que justificarte.</p>"
    },
    { "type": "text", "id": "cta_text", "label": "Boton", "default": "Empezar sin riesgo" },
    { "type": "url", "id": "cta_link", "label": "Enlace del boton" }
  ],
  "presets": [{ "name": "Garantia" }]
}
{% endschema %}
