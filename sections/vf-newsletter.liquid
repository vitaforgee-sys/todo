<section class="vf-section vf-section--deep">
  <div class="vf-wrap vf-wrap--narrow vf-text-center vf-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="vf-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="vf-lede" style="margin-bottom: 2rem;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'vf-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="vf-alert vf-alert--ok">Hecho. Revisa tu bandeja de entrada para confirmar la suscripcion.</p>
      {%- elsif form.errors -%}
        <p class="vf-alert vf-alert--error">{{ form.errors.messages.email }}</p>
      {%- endif -%}

      <div class="vf-newsletter__row">
        <div class="vf-field" style="margin-bottom: 0;">
          <label for="vf-newsletter-email" class="vf-visually-hidden">Correo electronico</label>
          <input
            type="email"
            id="vf-newsletter-email"
            name="contact[email]"
            class="vf-input"
            autocomplete="email"
            placeholder="tunombre@correo.com"
            required
          >
        </div>
        <button type="submit" class="vf-btn vf-btn--primary">{{ section.settings.button | escape }}</button>
      </div>

      {%- if section.settings.legal != blank -%}
        <div class="vf-form-note">{{ section.settings.legal }}</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Boletin",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo", "default": "Carta mensual" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Lo que nos habria gustado que nos contaran a los 50" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Una carta al mes con informacion util sobre menopausia, descanso, huesos y alimentacion. Escrita en cristiano y sin venderte nada en cada parrafo.</p>"
    },
    { "type": "text", "id": "button", "label": "Boton", "default": "Quiero recibirla" },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Aviso de privacidad",
      "default": "<p>Responsable: VitaForge. Finalidad: enviarte nuestra carta mensual. Puedes darte de baja en cualquier momento desde el propio correo. Mas informacion en la politica de privacidad.</p>"
    }
  ],
  "presets": [{ "name": "Boletin" }]
}
{% endschema %}
